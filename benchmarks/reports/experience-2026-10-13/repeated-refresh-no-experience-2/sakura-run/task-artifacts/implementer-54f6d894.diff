+// refresh: 用新 token 替换旧 token，返回新 token
+// 注意：不要返回 current（旧 token），否则会返回 stale token
+export function refresh(current: Token, next: Token) {
+  return new Token({ value: next.value, expires: Math.min(next.expires, 20) });
